# Copy this file to `.env` in the repo root and fill in the values.
# `.env` is gitignored — never commit real keys. This template is committed,
# so it must stay free of real secrets.

# --- Jamendo (REQUIRED for stage-1 data fetching) ---
# Register a free non-commercial app at https://devportal.jamendo.com
# and paste the Client ID. (The Client Secret is only needed for OAuth.)
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# --- DeepSeek (REQUIRED for LLM tagging in 06 and the agent later) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- MySQL (the `mymusic` database the Koa backend already uses) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=mymusic

# --- GPU server for align step 04 (optional; not read by scripts yet) ---
GPU_SSH="ssh -p <port> root@<host>"
GPU_SSH_PASSWORD=

# Interpreter with torch for the recommender (system python usually lacks it)
RECOMMEND_PYTHON=python

# Optional shared key for Koa -> Agent (:8000). Leave empty for loopback-only.
AGENT_KEY=
